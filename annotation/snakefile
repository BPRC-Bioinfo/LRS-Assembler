    log:
        "LRS-annotation/{species}/{sample}/{sample}_final.log"
    shell:
        """
        Rscript -e "rmarkdown::render('{input.markdown}', output_format='html_document',params=list(sample='{wildcards.sample}',species='{wildcards.species}'))" 2> {log}
        """


