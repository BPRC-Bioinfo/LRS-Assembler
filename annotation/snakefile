    threads: 2
    conda:
        "../envs/sambed.yaml"
    shell:
        """
        samtools view -@ {threads} -bh {input.sam} > {output.bam}
        samtools sort -@ {threads} -o {output.sort} {output.bam}
        bedtools bamtobed -i {output.sort} | awk '{{ sub(/.*_/, "", $4); print $1"\t"$2"\t"$3"\t"$4"\tFlanking gene\t"$6 }}' > {output.bed}
        """

